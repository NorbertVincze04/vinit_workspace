# Copy to api/.env for `npm run dev` on your PC. Docker Compose reads the repo-root .env instead.
NODE_ENV=development
PORT=3000

# The Postgres container from docker-compose.yml (published on 127.0.0.1:5433).
DB_HOST=localhost
DB_PORT=5433
DB_USER=vinit
DB_PASSWORD=change-me
DB_NAME=vinit

# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Keep false on plain http (home network). Set true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Reverse proxies in front of the API (nginx in Docker = 1). Empty when running on the PC directly.
TRUST_PROXY=
