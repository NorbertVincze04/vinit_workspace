# Copy to .env (next to docker-compose.yml). Used by `docker compose`.
# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DB_PASSWORD=
JWT_SECRET=

# ---- Integrations (optional). Credentials live only here, never in the database. ----
# Invoices: smartbill or oblio (sending is not built yet; the Infra page shows the status).
INVOICE_PROVIDER=
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=
OBLIO_EMAIL=
OBLIO_SECRET=
OBLIO_CIF=
OBLIO_SERIES=
# Outside uptime monitoring (not built yet; the built-in checker needs nothing).
UPTIMEROBOT_API_KEY=
# The multi-tenant booking platform (not built yet).
TENANT_PLATFORM_URL=
TENANT_PLATFORM_TOKEN=
